# ─────────────────────────────── builder ───────────────────────────────
FROM node:22-bookworm-slim AS builder

WORKDIR /build

# Manifests first: a source-only change then reuses the install layer.
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web/ ./

# The API base URL is inlined at build time, so the image is environment-
# specific. That is inherent to a static SPA: there is no server to read an
# env var at request time. Pass it per environment:
#   docker build --build-arg VITE_API_URL=https://api.example.com -f Dockerfile.web .
ARG VITE_API_URL=http://127.0.0.1:8080
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ─────────────────────────────── runtime ───────────────────────────────
FROM nginx:1.27-alpine AS runtime

COPY --from=builder /build/dist /usr/share/nginx/html

# The app is a single-page application: every route must fall back to
# index.html, or a refresh on /c/<id>/r/<id> is a 404 from nginx.
RUN printf '%s\n' \
    'server {' \
    '  listen 8082;' \
    '  root /usr/share/nginx/html;' \
    '  location / { try_files $uri $uri/ /index.html; }' \
    '  location /assets/ {' \
    '    expires 1y;' \
    '    add_header Cache-Control "public, immutable";' \
    '  }' \
    '}' > /etc/nginx/conf.d/default.conf

EXPOSE 8082

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8082/ >/dev/null || exit 1
