# ─────────────────────────────── builder ───────────────────────────────
FROM node:22-bookworm-slim AS builder

# Pinned so the image resolves the committed pnpm-lock.yaml the same way a
# developer's machine does. Bump this and the lockfile together.
ARG PNPM_VERSION=11.18.0
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /build

# The workspace layout has to be preserved, not flattened.
#
# `apps/web/vite.config.ts` aliases `@genzh/shared` to
# `../../packages/shared/src` — the package is compiled from source, not
# consumed as a build artefact. An image that copied only `apps/web` would
# resolve that alias to a path outside the context and fail at bundle time.
#
# Manifests and the lockfile first, so a source-only change reuses the
# install layer.
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/

# Only the two importers this image needs. `apps/mobile` is a workspace member
# and appears in the lockfile, but a filtered install never visits it — which
# is what lets .dockerignore drop its 3 GB from the context.
#
# The ENV is part of the same problem: pnpm re-verifies the workspace before
# every `pnpm run`, sees it was installed with a filter, and silently starts a
# full unfiltered install to reconcile it — pulling in that same React Native
# tree, which is not even in the context. Off, so the filtered install stands.
#
# MINIMUM_RELEASE_AGE for the same reason CI sets it: pnpm 11 rejects any
# lockfile entry published within the last 24 hours, so without this the image
# stops building for a day after every dependency bump — for a lockfile that is
# already committed and reviewed. The check earns its keep at resolution time,
# on a developer's machine, where pnpm's default still applies.
ENV PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false \
    PNPM_CONFIG_MINIMUM_RELEASE_AGE=0 \
    PNPM_CONFIG_IGNORE_SCRIPTS=true
RUN pnpm install --frozen-lockfile --filter web --filter @genzh/shared

COPY packages/shared/ packages/shared/
COPY apps/web/ apps/web/

# Empty by default, and that is the point: `apps/web/src/lib/config.ts` falls
# back to an empty base URL, so the bundle calls `/api/v1/...` on whatever
# origin served it, and nginx below proxies that to the API. The image is
# therefore host-agnostic — the same digest runs against any server IP, with
# no rebuild and no CORS.
#
# Set it only to point the bundle at an API on a *different* origin:
#   docker build --build-arg VITE_API_URL=https://api.example.com -f Dockerfile.web .
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL

RUN pnpm --filter web run build

# ─────────────────────────────── runtime ───────────────────────────────
FROM nginx:1.27-alpine AS runtime

COPY --from=builder /build/apps/web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8082

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8082/ >/dev/null || exit 1
