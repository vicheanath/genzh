# ─────────────────────────────── builder ───────────────────────────────
FROM rust:1.90-bookworm AS builder

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/ apps/
COPY migrations/ migrations/

RUN cargo build --release --locked --bin media

# ─────────────────────────────── runtime ───────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --system --create-home --uid 10002 social
USER social
WORKDIR /home/social

COPY --from=builder /build/target/release/media /usr/local/bin/media

# 8081 is signalling (TCP). Media itself is UDP, on the range below.
EXPOSE 8081
EXPOSE 40000-40100/udp

ENV MEDIA_BIND=0.0.0.0:8081 \
    RUST_LOG=info

# NOTE ON NETWORKING
#
# WebRTC needs real UDP reachability. Docker's default bridge NAT breaks host
# candidates, so a containerised media server needs one of:
#
#   * `network_mode: host` (simplest; what docker-compose.yml uses on Linux),
#   * a published UDP range plus MEDIA_UDP_BIND pinned to it, or
#   * a TURN server, which relays and sidesteps the problem entirely.
#
# There is no configuration that makes bridge networking work without one of
# these — the container simply cannot advertise an address a peer can reach.
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8081/health || exit 1

ENTRYPOINT ["/usr/local/bin/media"]
