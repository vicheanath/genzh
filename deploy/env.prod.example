# Production environment for deploy/docker-compose.prod.yml.
#
# Copy to `.env` in the same directory as the compose file on the server:
#   cp env.prod.example .env && $EDITOR .env
#
# The deploy workflow generates this file from repository secrets instead, so
# you only need to edit it by hand for a manual deploy.

# ── the one that points at the box ──────────────────────────────────────────
# The address browsers use. A bare public IP is fine; a DNS name is better if
# you have one. No scheme, no port, no trailing slash.
DEPLOY_HOST=203.0.113.10

# Host port the site is served on. 80 gives you a plain http://<DEPLOY_HOST>/.
WEB_PORT=80

# LiveKit's node_ip (see livekit.yaml.template) has to be a real IP address,
# not a hostname — deploy.sh writes DEPLOY_HOST into it directly, which is
# correct as long as DEPLOY_HOST above is already a bare IP. Only set this if
# DEPLOY_HOST becomes a hostname instead (a Tailscale *.ts.net name from the
# HOME-SERVER.md HTTPS step, or a real domain) — point it at the box's actual
# IP on whatever network your clients dial it over, e.g. `tailscale ip -4`.
# LIVEKIT_NODE_IP=

# ── images ──────────────────────────────────────────────────────────────────
# Written by CI. Pin to an immutable tag (a commit SHA) rather than `latest`,
# so `docker compose up -d` deploys the build you actually tested and a
# rollback is just editing these two lines back.
IMAGE_API=ghcr.io/OWNER/REPO/api:main
IMAGE_WEB=ghcr.io/OWNER/REPO/web:main

# ── secrets ─────────────────────────────────────────────────────────────────
# JWT_SECRET signs user sessions; rotating it logs everybody out.
# Generate with:  openssl rand -base64 48
# Must be at least 32 characters — the API refuses to start otherwise.
JWT_SECRET=

# LiveKit: this process signs access tokens with the same key/secret LiveKit
# itself verifies with (see the livekit service in docker-compose.prod.yml).
# LIVEKIT_API_KEY can be any short identifier; generate LIVEKIT_API_SECRET
# the same way as JWT_SECRET.
LIVEKIT_API_KEY=genzh
LIVEKIT_API_SECRET=

POSTGRES_USER=social
POSTGRES_PASSWORD=
POSTGRES_DB=social

# ── auth ────────────────────────────────────────────────────────────────────
APP_ENV=production
# Left on so the first account can be created on a fresh box. Turn it off once
# OAuth is configured, or the instance accepts open password signups forever.
ALLOW_PASSWORD_SIGNUP=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# ── observability ───────────────────────────────────────────────────────────
RUST_LOG=info
LOG_FORMAT=json
