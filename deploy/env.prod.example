# Production environment for deploy/docker-compose.prod.yml.
#
# Copy to `.env` in the same directory as the compose file on the server:
#   cp env.prod.example .env && $EDITOR .env
#
# The deploy workflow generates this file from repository secrets instead, so
# you only need to edit it by hand for a manual deploy.

# ── the one that points at the box ──────────────────────────────────────────
# The address browsers use. A bare public IP is fine; a DNS name is better if
# you have one. No scheme, no port, no trailing slash.
DEPLOY_HOST=203.0.113.10

# Host port the site is served on. 80 gives you a plain http://<DEPLOY_HOST>/.
WEB_PORT=80

# ── images ──────────────────────────────────────────────────────────────────
# Written by CI. Pin to an immutable tag (a commit SHA) rather than `latest`,
# so `docker compose up -d` deploys the build you actually tested and a
# rollback is just editing these three lines back.
IMAGE_API=ghcr.io/OWNER/REPO/api:main
IMAGE_MEDIA=ghcr.io/OWNER/REPO/media:main
IMAGE_WEB=ghcr.io/OWNER/REPO/web:main

# ── secrets ─────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48
#
# JWT_SECRET signs user sessions; rotating it logs everybody out.
# MEDIA_TOKEN_SECRET is shared with the media servers and ONLY them. The two
# must differ and each must be at least 32 characters — the API refuses to
# start otherwise, because one key able to forge the other's tokens defeats
# the point of splitting the planes.
JWT_SECRET=
MEDIA_TOKEN_SECRET=

POSTGRES_USER=social
POSTGRES_PASSWORD=
POSTGRES_DB=social

# ── auth ────────────────────────────────────────────────────────────────────
APP_ENV=production
# Left on so the first account can be created on a fresh box. Turn it off once
# OAuth is configured, or the instance accepts open password signups forever.
ALLOW_PASSWORD_SIGNUP=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# ── ICE ─────────────────────────────────────────────────────────────────────
STUN_URL=stun:stun.l.google.com:19302
# Without TURN, anyone behind symmetric NAT or a restrictive firewall cannot
# connect to voice at all. STUN alone is not a production answer — run coturn.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ── observability ───────────────────────────────────────────────────────────
RUST_LOG=info
LOG_FORMAT=json
