# LiveKit Configuration for Local Development
# Copy this to .env and adjust as needed

# === Database ===
DATABASE_URL=postgres://social:social@localhost:5432/social
DATABASE_MAX_CONNECTIONS=10
RUN_MIGRATIONS=true

# === JWT Secrets (generate unique values for production) ===
JWT_SECRET=your-very-secret-jwt-key-minimum-32-characters-long
JWT_ISSUER=social.api
JWT_AUDIENCE=social.client

# === Media Server Secrets ===
# NOTE: Must differ from JWT_SECRET
MEDIA_TOKEN_SECRET=your-very-secret-media-token-key-min-32-chars

# === Custom Media Server (Fallback) ===
# Uncomment to use custom WebRTC SFU instead of LiveKit
# MEDIA_SERVER_URL=ws://127.0.0.1:8081/ws/media

# === LiveKit Configuration ===
# For LOCAL DEVELOPMENT: Use docker-compose livekit service
# Change LIVEKIT_URL to match docker-compose setup

# Option 1: Use Docker Compose LiveKit (Recommended for Local Dev)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# Option 2: Use LiveKit Cloud
# 1. Sign up at https://livekit.cloud
# 2. Create a project
# 3. Get API key and secret
# 4. Set them below
# LIVEKIT_API_KEY=your-cloud-api-key
# LIVEKIT_API_SECRET=your-cloud-api-secret
# LIVEKIT_URL=wss://your-project.livekit.cloud

# === ICE Servers (WebRTC STUN/TURN) ===
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=username
# TURN_PASSWORD=password

# === API Configuration ===
API_BIND=0.0.0.0:8080

# === Frontend Configuration ===
VITE_API_URL=http://127.0.0.1:8080

# === Logging ===
RUST_LOG=info,api=debug

# === Environment ===
APP_ENV=development
ALLOW_PASSWORD_SIGNUP=true
FRONTEND_URL=http://localhost:5173

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20

# === Message Rate Limiting ===
MESSAGE_BURST_LIMIT=10
MESSAGE_BURST_WINDOW_SECONDS=10
MESSAGE_REPEAT_WINDOW_SECONDS=30
MESSAGE_REPEAT_LIMIT=3

# === OAuth (Optional) ===
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# DISCORD_CLIENT_ID=your-discord-client-id
# DISCORD_CLIENT_SECRET=your-discord-client-secret
# DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback/discord
