# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
#
# Generate JWT_SECRET with:
#   openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ---- database ----
DATABASE_URL=postgres://social:social@localhost:5432/social
DATABASE_MAX_CONNECTIONS=10
RUN_MIGRATIONS=true

# ---- environment & auth mode ----
# "development" | "production" | "test"
APP_ENV=development
# Defaults to true in development, false in production.
# In production, users must register via Google or Discord OAuth.
ALLOW_PASSWORD_SIGNUP=true
FRONTEND_URL=http://localhost:5173

# ---- oauth providers (optional in dev, required in prod) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/discord/callback

# ---- gif picker ----
# Tenor v2 key, from https://developers.google.com/tenor. Optional: leave it
# blank and the composer's GIF button disappears rather than opening a picker
# that cannot search. The key is never sent to a browser — /api/v1/gifs/*
# proxies the request.
TENOR_API_KEY=
# Identifies this product to Tenor for rate-limiting. Not a secret.
TENOR_CLIENT_KEY=genzh

# ---- secrets ----
# Signs user access tokens. Rotating it logs everybody out. Must be at least
# 32 characters.
JWT_SECRET=

# ---- tokens ----
JWT_ISSUER=social.api
JWT_AUDIENCE=social.client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Long enough to survive a mobile network handover between the HTTP call and
# the WebSocket, short enough that a stolen token is worthless. Clamped to
# 15..600 regardless of what is set here.
MEDIA_TOKEN_TTL_SECONDS=120

# ---- media servers ----
# Comma-separated WebSocket URLs, as a *client* would dial them. The API hashes
# the room id to pick one, so every participant of a room lands on the same
# process — which is what an SFU requires.
MEDIA_SERVER_URL=ws://127.0.0.1:8081/ws/media

# ---- ICE (STUN & TURN) ----
# When running with docker compose, the local coturn service is available on 3478.
STUN_URL=stun:127.0.0.1:3478
# For external/Google STUN fallback: stun:stun.l.google.com:19302
TURN_URL=turn:127.0.0.1:3478?transport=udp
TURN_USERNAME=genzh
TURN_PASSWORD=secretpass
# Force every candidate through TURN. Useful to prove the relay path works.
ICE_RELAY_ONLY=false

# ---- api ----
API_BIND=0.0.0.0:8080
MAX_BODY_BYTES=262144
REQUEST_TIMEOUT_SECONDS=30
# Comma-separated origins; blank or `*` allows any (development only).
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20

# ---- anti-spam ----
# Per account, per room, and enforced for messages posted over the WebSocket as
# well as the REST endpoint — the per-address budget above sees neither.
# Messages allowed per burst window.
MESSAGE_BURST_LIMIT=10
MESSAGE_BURST_WINDOW_SECONDS=10
# How long an identical message is remembered, and how many identical ones go
# through before the next is refused. Not 1: saying "ok" twice is conversation.
MESSAGE_REPEAT_WINDOW_SECONDS=30
MESSAGE_REPEAT_LIMIT=3

# ---- observability ----
RUST_LOG=info,api=debug
# `json` for structured output, anything else for human-readable.
LOG_FORMAT=

# ---- web client (build-time) ----
VITE_API_URL=http://127.0.0.1:8080
