# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
#
# Generate the two secrets with:
#   openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ---- database (API only; the media server has no database access) ----
DATABASE_URL=postgres://social:social@localhost:5432/social
DATABASE_MAX_CONNECTIONS=10
RUN_MIGRATIONS=true

# ---- environment & auth mode ----
# "development" | "production" | "test"
APP_ENV=development
# Defaults to true in development, false in production.
# In production, users must register via Google or Discord OAuth.
ALLOW_PASSWORD_SIGNUP=true
FRONTEND_URL=http://localhost:5173

# ---- oauth providers (optional in dev, required in prod) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/discord/callback

# ---- secrets ----
# Signs user access tokens. Rotating it logs everybody out.
JWT_SECRET=

# Shared with the media servers, and ONLY with them. Must differ from
# JWT_SECRET: the two planes are separate trust domains, and a compromised
# media server must not be able to forge user sessions. The API refuses to
# start if they match, or if either is shorter than 32 characters.
MEDIA_TOKEN_SECRET=

# ---- tokens ----
JWT_ISSUER=social.api
JWT_AUDIENCE=social.client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Long enough to survive a mobile network handover between the HTTP call and
# the WebSocket, short enough that a stolen token is worthless. Clamped to
# 15..600 regardless of what is set here.
MEDIA_TOKEN_TTL_SECONDS=120

# ---- media servers ----
# Comma-separated WebSocket URLs, as a *client* would dial them. The API hashes
# the room id to pick one, so every participant of a room lands on the same
# process — which is what an SFU requires.
MEDIA_SERVER_URL=ws://127.0.0.1:8081/ws/media

# ---- ICE ----
STUN_URL=stun:stun.l.google.com:19302
# Without a TURN server, users behind symmetric NAT or restrictive firewalls
# cannot connect at all. Run coturn in production.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Force every candidate through TURN. Useful to prove the relay path works.
ICE_RELAY_ONLY=false

# ---- api ----
API_BIND=0.0.0.0:8080
MAX_BODY_BYTES=262144
REQUEST_TIMEOUT_SECONDS=30
# Comma-separated origins; blank or `*` allows any (development only).
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20

# ---- anti-spam ----
# Per account, per room, and enforced for messages posted over the WebSocket as
# well as the REST endpoint — the per-address budget above sees neither.
# Messages allowed per burst window.
MESSAGE_BURST_LIMIT=10
MESSAGE_BURST_WINDOW_SECONDS=10
# How long an identical message is remembered, and how many identical ones go
# through before the next is refused. Not 1: saying "ok" twice is conversation.
MESSAGE_REPEAT_WINDOW_SECONDS=30
MESSAGE_REPEAT_LIMIT=3

# ---- media server ----
MEDIA_BIND=0.0.0.0:8081
# Local addresses for the SFU's UDP sockets. `0.0.0.0:0` lets the OS pick a
# port per connection; pin a range when running behind a firewall.
MEDIA_UDP_BIND=0.0.0.0:0
# Comma-separated allow-list: opus,vp8,vp9,h264. Blank means all of them.
MEDIA_CODECS=
# `client` (default) or `server`. See docs/media-protocol.md.
MEDIA_VAD_MODE=client
MEDIA_AUDIO_LEVEL_EXT_ID=1
# Push everyone's camera at every participant on join. Off by default: a
# twenty-person room would hand a phone nineteen video streams.
MEDIA_AUTO_SUBSCRIBE_VIDEO=false
MEDIA_ROOM_CAPACITY=100

# ---- observability ----
RUST_LOG=info,api=debug,media=debug
# `json` for structured output, anything else for human-readable.
LOG_FORMAT=
