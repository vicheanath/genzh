# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
#
# Generate JWT_SECRET with:
#   openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ---- database ----
DATABASE_URL=postgres://social:social@localhost:5432/social
DATABASE_MAX_CONNECTIONS=10
RUN_MIGRATIONS=true

# ---- environment & auth mode ----
# "development" | "production" | "test"
APP_ENV=development
# Defaults to true in development, false in production.
# In production, users must register via Google or Discord OAuth.
ALLOW_PASSWORD_SIGNUP=true
FRONTEND_URL=http://localhost:5173

# ---- oauth providers (optional in dev, required in prod) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/discord/callback

# ---- secrets ----
# Signs user access tokens. Rotating it logs everybody out. Must be at least
# 32 characters.
JWT_SECRET=

# ---- tokens ----
JWT_ISSUER=social.api
JWT_AUDIENCE=social.client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---- LiveKit (media plane) ----
# This process signs LiveKit access tokens with LIVEKIT_API_KEY/SECRET — the
# same pair LiveKit itself verifies with. All three are required; the API
# refuses to start without them.
#
# LIVEKIT_URL is the address a *browser* dials to reach LiveKit, not
# necessarily this process's own view of it — with the bundled docker-compose
# service, that is ws://127.0.0.1:7880, not the compose-internal hostname.
#
# For LiveKit Cloud, use the wss:// URL and API key/secret from your project
# dashboard instead of the local defaults below.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://127.0.0.1:7880
# How long an access token is accepted for. Long enough that a brief network
# blip does not force a rejoin, short enough that a revoked permission is
# reflected on the next one.
LIVEKIT_TOKEN_TTL_SECONDS=3600

# ---- api ----
API_BIND=0.0.0.0:8080
MAX_BODY_BYTES=262144
REQUEST_TIMEOUT_SECONDS=30
# Comma-separated origins; blank or `*` allows any (development only).
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20

# ---- anti-spam ----
# Per account, per room, and enforced for messages posted over the WebSocket as
# well as the REST endpoint — the per-address budget above sees neither.
# Messages allowed per burst window.
MESSAGE_BURST_LIMIT=10
MESSAGE_BURST_WINDOW_SECONDS=10
# How long an identical message is remembered, and how many identical ones go
# through before the next is refused. Not 1: saying "ok" twice is conversation.
MESSAGE_REPEAT_WINDOW_SECONDS=30
MESSAGE_REPEAT_LIMIT=3

# ---- observability ----
RUST_LOG=info,api=debug
# `json` for structured output, anything else for human-readable.
LOG_FORMAT=

# ---- web client (build-time) ----
VITE_API_URL=http://127.0.0.1:8080
