{
  "expo": {
    "name": "GenZH",
    "slug": "mobile",
    "scheme": "genzh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow GenZH to access your camera for video calls.",
          "microphonePermission": "Allow GenZH to access your microphone for voice channels and calls."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.genzh.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow GenZH to access your camera for video calls and profile pictures.",
        "NSMicrophoneUsageDescription": "Allow GenZH to access your microphone for voice rooms and calls.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "bitcode": false,
      "associatedDomains": [
        "applinks:genzh.pdfpaperkit.com"
      ]
    },
    "android": {
      "package": "com.genzh.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#181815",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "genzh.pdfpaperkit.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "genzh.pdfpaperkit.com",
              "pathPrefix": "/invites"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "58b78782-3fbb-4b17-aaa3-4a9cbdd48724"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/58b78782-3fbb-4b17-aaa3-4a9cbdd48724"
    }
  }
}
