# Base URL of the genzh control-plane API.
# Leave empty to use relative paths with Vite's proxy (recommended for local dev and LAN testing).
# Or set explicitly to an absolute URL if connecting directly across origins.
VITE_API_URL=

# Backend target for Vite dev proxy (defaults to http://127.0.0.1:8080)
# BACKEND_URL=http://127.0.0.1:8080

