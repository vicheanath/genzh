# Same as API builder stage but runs the seed binary
ARG RUST_VERSION=1.94
FROM rust:${RUST_VERSION}-bookworm

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/ apps/
COPY migrations/ migrations/

# Run seed with same environment as `make seed`
ENTRYPOINT ["cargo", "run", "--release", "--locked", "--bin", "seed"]
